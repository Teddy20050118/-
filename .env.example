# OrderSuggest settings

# Server
HOST=127.0.0.1
PORT=7890
DEFAULT_RESTAURANT_NAME=預設餐廳

# School/OpenAI-compatible model API
# Example: https://api.example.edu/v1
API_BASE_URL=
API_KEY=
API_MODEL=mistral-small-4
VISION_MODEL=gemma-4-31b
VISION_VERIFY_MODEL=mistral-small-4
RECOMMEND_MODEL=mistral-small-4
RESPONSE_MODEL=mistral-small-4
FAST_FALLBACK_MODEL=vibe
VISION_TEMPERATURE=0
RECOMMEND_TEMPERATURE=0.2
RESPONSE_TEMPERATURE=0.5

# LINE Messaging API (LINE Developers Console > Messaging API channel)
# Webhook URL: https://your-public-domain.example/line/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Optional model names for specific subtasks. Leave blank to use API_MODEL.
PREF_MODEL=
CLASSIFY_MODEL=

# Feature flags
USE_LLM_EXTRACTION=false
USE_LLM_CLASSIFICATION=false

# Ollama fallback only. Used when API_BASE_URL or API_KEY is empty.
OLLAMA_MODEL=gemma3:12b
